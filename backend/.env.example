# ── Server ────────────────────────────────────────────────
PORT=5000
HOST=0.0.0.0
NODE_ENV=development
FRONTEND_URL=http://localhost:3000

# ── Database (Prisma) ────────────────────────────────────
DATABASE_URL=postgres://postgres:j3jeaq7jljp5r5wcw2hy@201.18.193.46:9999/travelcrm?sslmode=disable

# ── Auth / JWT ────────────────────────────────────────────
JWT_SECRET=
JWT_REFRESH_SECRET=

# ── Branch config ─────────────────────────────────────────
MAIN_BRANCH_ID=

# ── OTP ───────────────────────────────────────────────────
DISABLE_OTP=false
APP_NAME=Claidsphere Solutions

# ── Cloudinary ────────────────────────────────────────────
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ── Google OAuth ──────────────────────────────────────────
# From console.cloud.google.com → APIs & Services → Credentials
# → OAuth 2.0 Client IDs → Web application.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Must match a "Authorised redirect URI" on that OAuth client EXACTLY.
# This points at the FRONTEND page that receives the code, e.g.
#   http://localhost:3000/ad-campaigns/callback/google
GOOGLE_REDIRECT_URI=

# ── Google Ads API (reading spend / clicks / conversions) ─
# OAuth alone is NOT enough to call the Ads API. You also need a developer
# token from your Google Ads MANAGER account: Tools & Settings → API Center.
# A new token starts at "Test account" access and only works against test
# accounts until Google approves it for Basic access.
GOOGLE_ADS_DEVELOPER_TOKEN=
# Only needed when you reach the ad account through a manager (MCC) account.
# Ten digits, no dashes.
GOOGLE_ADS_LOGIN_CUSTOMER_ID=
# Optional - defaults to v18
GOOGLE_ADS_API_VERSION=

# ── Meta / Facebook Lead Ads ──────────────────────────────
# From developers.facebook.com → your app → Settings → Basic
META_APP_ID=
META_APP_SECRET=
# Any random string you invent. Paste the SAME value into Meta's webhook setup,
# and use it as ?token=... when posting from Zapier/Make.
META_WEBHOOK_VERIFY_TOKEN=
# PAGE access token (not a user token) for the page that owns the lead forms.
# Required to read lead answers - without it, leads arrive empty.
# Legacy, optional: only used for leads from Pages no branch has connected via
# "Connect Meta". Customers now bring their own Page tokens by logging in.
META_PAGE_ACCESS_TOKEN=
# Optional - defaults to v21.0
META_GRAPH_VERSION=
# Must match a "Valid OAuth Redirect URI" in the Meta app EXACTLY.
# Points at the FRONTEND page that receives the code, e.g.
#   http://localhost:3000/ad-campaigns/callback/meta
# If unset, it is derived from FRONTEND_URL as <FRONTEND_URL>/ad-campaigns/callback/meta
META_REDIRECT_URI=
# Only for Business-type apps using "Facebook Login for Business": the ID of the
# Configuration (Facebook Login for Business → Configurations). When set it is
# sent as config_id INSTEAD of the scope list. Leave empty for plain Facebook Login.
META_LOGIN_CONFIG_ID=

# ── Google Ads Lead Forms ─────────────────────────────────
# Any random string you invent. Paste the SAME value into the Lead Form's
# "Webhook key" field in Google Ads. Google echoes it back as `google_key`.
GOOGLE_ADS_WEBHOOK_KEY=
# A SEPARATE random string, used only by Zapier/Make/curl, which cannot send
# google_key. Pass it as ?token=... or an X-Webhook-Token header.
# Previously this endpoint reused META_WEBHOOK_VERIFY_TOKEN by mistake.
GOOGLE_ADS_WEBHOOK_TOKEN=

# ── Evolution API (WhatsApp) ──────────────────────────────
EVOLUTION_API_URL=
EVOLUTION_API_KEY=
EVOLUTION_CHAT_INSTANCE=
EVOLUTION_OTP_INSTANCE=
WEBHOOK_BASE_URL=

# ── WhatsApp (legacy/single-instance) ─────────────────────
WHATSAPP_INSTANCE_NAME=
WHATSAPP_VERIFY_TOKEN=

# ── Central WhatsApp ──────────────────────────────────────
CENTRAL_WHATSAPP_INSTANCE=
CENTRAL_WHATSAPP_NUMBER=
CENTRAL_WA_INSTANCE_NAME=

# ── Flight lookup (itinerary flight details) ──────────────
# Which provider resolves a flight number + date into a schedule.
# Unset or "mock" uses the built-in sample generator: it returns realistic but
# INVENTED schedules, and every response is flagged so the builder badges them
# as sample data. Wire a real provider in src/services/flight.service.js
# (add it to PROVIDERS), then set this to its name plus whatever keys it needs.
FLIGHT_API_PROVIDER=mock
