    "express-validator": "^7.2.0",
    "google-auth-library": "10.6.2",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^1.4.5-lts.1",
    "node-cron": "^3.0.3",
    "node-fetch": "3.3.2",
    "pg": "8.21.0",
